# ============================================================
# MedButler 云端训练 / 评估环境变量模板（与 v4 服务的 .env 无关）
# v4 服务的运行配置在 deploy/api/v4/.env.example
# 用法：云端按需 export，或写入 ~/.bashrc
# ============================================================

# ---- HuggingFace / ModelScope（训练时拉模型、数据）----
# 国内镜像加速
HF_ENDPOINT=https://hf-mirror.com
#HF_TOKEN=你的token

# ---- Python 包镜像（uv / pip）----
# uv 项目已在各 pyproject.toml 里配 [[tool.uv.index]]（阿里云/清华镜像）
UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple/

# ---- GPU / 训练 ----
# 指定训练可见显卡（多卡机器上按需改）
CUDA_VISIBLE_DEVICES=0
# transformers tokenizer 并行，训练时可开
TOKENIZERS_PARALLELISM=false

# ---- NLTK 数据（EvalScope 评估用）----
NLTK_DATA=/root/nltk_data
