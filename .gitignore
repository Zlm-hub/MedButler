# 字节码 / 缓存
__pycache__/
*.py[cod]
*.egg-info/

# 虚拟环境
.venv/
venv/
env/

# 运行日志
logs/

# 环境配置（密钥/本机配置不入库，模板见 .env.example）
.env
deploy/api/v4/.env

# Unsloth 编译缓存（训练时自动再生，非源码）
unsloth_compiled_cache/

# 系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
deploy/api/v4/users.db
media/

# 运行时生成的会话库与上传图片（含用户数据，不入库）
deploy/api/v4/chat.db
