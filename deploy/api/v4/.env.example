# ============================================================
# MedButler v4 运行配置
# 用法：复制本文件为同目录 .env（cp .env.example .env），按需修改
# 全部项都有默认值，不建 .env 服务也能正常跑
# ============================================================

# ---- 下游 llama-server ----
LLAMA_BASE_URL=http://127.0.0.1:8080

# ---- v4 服务自身（uvicorn 启动命令可参考；实际端口以启动命令为准）----
V4_HOST=0.0.0.0
V4_PORT=8000

# ---- 图像预处理 ----
# 上传图最长边缩放上限（像素），越大越清晰也越慢、越吃显存
# 化验单 1280 够用；病理等小字密集报告建议 1600-2048
IMAGE_MAX_SIZE=1600

# ---- VL 生成（多模态读图，开思考）----
VL_MODEL_NAME=medmodelvl
VL_MAX_TOKENS=4096
# 思考型模型读图偶发 content 为空，换温度重试；首次固定 0.0
VL_MAX_ATTEMPTS=3
VL_RETRY_TEMPERATURE=0.3
# 思考防复读：temp 0.0 贪心解码下思考易陷入循环，重复惩罚打断（1.0=关闭）
VL_REPEAT_PENALTY=1.1
VL_REPEAT_LAST_N=256
# 频率惩罚：按 token 累计出现次数惩罚，专治句子级变体循环
# 读图段别超过 0.1，太高会搅乱输出分布（化验单格式词天然高频重复）
VL_FREQUENCY_PENALTY=0.1

# ---- LLM 生成（文本建议，关思考）----
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.6
LLM_REPEAT_PENALTY=1.2
# 建议段防复读（词汤/变体循环）
LLM_REPEAT_LAST_N=256
LLM_FREQUENCY_PENALTY=0.3
LLM_MAX_ATTEMPTS=2

# ---- 流式超时（秒）----
# read 是「相邻两个 chunk 的最大间隔」，不是总时长，一般不用动
STREAM_CONNECT_TIMEOUT=10.0
STREAM_READ_TIMEOUT=300.0
STREAM_WRITE_TIMEOUT=60.0

# ---- 日志级别 ----
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
